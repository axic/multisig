{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      // Web-only: resolve core from source (matches the Vite alias) so the web
      // app needs no core build. Safe because web is built by Vite/tsc, not
      // @vercel/node — unlike the api, which resolves deps via node_modules -> dist.
      "@multisig/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
