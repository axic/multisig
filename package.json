{
  "name": "multisig",
  "version": "0.0.0",
  "private": true,
  "description": "Safe-style multisig app (Solcore contract) — web + api + db",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @multisig/db generate",
    "db:push": "dotenv -e .env -- pnpm --filter @multisig/db push",
    "db:studio": "dotenv -e .env -- pnpm --filter @multisig/db studio"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
