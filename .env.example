# --- Database (Neon Postgres) ---
# LOCAL: use the DIRECT (non-pooler) Neon URL here — the host WITHOUT "-pooler".
# `pnpm db:push` loads this root .env (via dotenv-cli) and pushes the schema, and
# schema pushes/migrations must not go through the pooler (pgbouncer).
# ON VERCEL: don't rely on this file — set DATABASE_URL to the POOLED (-pooler)
# URL in the API project's env vars (that's what the serverless driver uses).
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/multisig?sslmode=require"

# --- Chain / RPC (packages/core reads these) ---
# Comma-separated list of enabled chain ids. v1 default: Sepolia.
MULTISIG_CHAIN_IDS="11155111"
# Per-chain RPC endpoints, keyed by chain id.
RPC_URL_11155111="https://sepolia.example/your-key"

# --- Web (apps/web, Vite — must be prefixed VITE_) ---
VITE_API_BASE_URL="http://localhost:8787"
VITE_MULTISIG_CHAIN_IDS="11155111"
VITE_RPC_URL_11155111="https://sepolia.example/your-key"
# Multisig creation bytecode (0x…), from the solcore pipeline
# (contracts/solcore/out/Wallet.json .bytecode.object). Enables the "Deploy"
# button; when unset the UI falls back to tracking an existing address.
VITE_MULTISIG_CREATION_CODE=""
# WalletConnect Cloud project id for the wallet connector.
VITE_WALLETCONNECT_PROJECT_ID=""
